# Postgres (used by docker-compose.yml and backend/.env's DATABASE_URL)
POSTGRES_USER=higiexpo
POSTGRES_PASSWORD=changeme
POSTGRES_DB=higiexpo

# Backend
# Note: 5433 on the host (mapped in docker-compose.yml) to avoid clashing
# with other local Postgres instances on the default 5432 — the container
# itself still listens on 5432 internally. Only used when running the
# backend directly with `npm run dev` — the `app` service in
# docker-compose.yml builds its own DATABASE_URL from the Postgres vars
# above, pointed at the `postgres` service over the Docker network.
DATABASE_URL=postgresql://higiexpo:changeme@localhost:5433/higiexpo
# Required by both `npm run dev` and `docker compose up` (the app service
# has no fallback — it refuses to start without this set). Generate a real
# random value for anything beyond local dev; never reuse "changeme".
JWT_SECRET=changeme
PORT=3000
