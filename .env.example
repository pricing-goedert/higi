# Postgres (used by docker-compose.yml and backend/.env's DATABASE_URL)
POSTGRES_USER=higiexpo
POSTGRES_PASSWORD=changeme
POSTGRES_DB=higiexpo

# Backend
# Note: 5433 on the host (mapped in docker-compose.yml) to avoid clashing
# with other local Postgres instances on the default 5432 — the container
# itself still listens on 5432 internally.
DATABASE_URL=postgresql://higiexpo:changeme@localhost:5433/higiexpo
JWT_SECRET=changeme
PORT=3000
